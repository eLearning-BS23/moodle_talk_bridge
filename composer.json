{
    "name": "moodle-talk-bridge/moodle_talk_bridge",
    "description": "Nextcloud companion app for the Moodle mod_nextcloudtalk integration.",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
